<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TactiX_App.ViewModels.Popup"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="TactiX_App.Views.Popup.ErrorPopupView"
        x:DataType="vm:ErrorPopupViewModel"
        Width="600" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="{StaticResource ErrorPopupTitle}">

    <Design.DataContext>
        <vm:ErrorPopupViewModel />
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Label x:Name="Label_ErrorCode" Grid.Row="0" Content="{StaticResource ErrorPopupLabelErrorCode}" />
        <TextBox x:Name="Tbx_ErrorCode" Grid.Row="1" Text="{Binding ReportModel.ErrorCode}" IsReadOnly="True" />
        <Label x:Name="Label_ErrorDesc" Grid.Row="2" Content="{StaticResource ErrorPopupLabelErrorDesc}" />
        <TextBox x:Name="Tbx_ErrorDesc" Grid.Row="3" Text="{Binding ReportModel.ErrorDesc}" IsReadOnly="True" />
        <Label x:Name="Label_FeedbackWay" Grid.Row="4" Content="{StaticResource ErrorPopupLabelFeedback}" />
        <TextBox x:Name="Tbx_FeedbackWay" Grid.Row="5"
                 Text="{Binding ReportModel.FeedbackWay, Mode=TwoWay}" />
        <Label x:Name="Label_FeedbackInfo" Grid.Row="6" Content="{StaticResource ErrorPopupLabelUserDesc}" />
        <TextBox x:Name="Tbx_FeedbackInfo" Grid.Row="7" Watermark="{StaticResource ErrorPopupTbxUserDesc}"
                 Text="{Binding ReportModel.FeedbackInfo, Mode=TwoWay}" />
        <Grid Grid.Row="9" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="120" Height="30" HorizontalContentAlignment="Center"
                    Content="{StaticResource ErrorPopupBtnSendFeedback}"
                    Command="{Binding PostReport}" />
            <Button Grid.Column="2" Width="120" Height="30" HorizontalContentAlignment="Center"
                    Content="{StaticResource ErrorPopupBtnClose}" />
        </Grid>
    </Grid>
</Window>