<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:TactiX_App.ViewModels;assembly=TactiX_App"
			 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="900"
			 FontFamily="Microsoft YaHei UI, SimSun, sans-serif"
			 x:DataType="vm:HomeScreenViewModel"
			 x:Class="TactiX_App.Views.HomeScreenView">

	<suki:SukiSideMenu IsSearchEnabled="True" SelectionMode="Toggle" x:Name="SideMenu">

		<suki:SukiSideMenuItem Header="{Binding Language.HOMESCREEN_SIDE_NEWS}"
							   Classes="Compact">
			<suki:SukiSideMenuItem.Icon>
				<materialIcons:MaterialIcon Kind="Home" />
			</suki:SukiSideMenuItem.Icon>
			<suki:SukiSideMenuItem.PageContent>
				<ContentControl Content="{Binding NewsViewPageControl}"/>
			</suki:SukiSideMenuItem.PageContent>
		</suki:SukiSideMenuItem>

		<suki:SukiSideMenuItem Header="{Binding Language.HOMESCREEN_SIDE_TACTICSHALL}"
							   Classes="Compact">
			<suki:SukiSideMenuItem.Icon>
				<materialIcons:MaterialIcon Kind="TownHall" />
			</suki:SukiSideMenuItem.Icon>
			<suki:SukiSideMenuItem.PageContent>
				<ContentControl Content="{Binding TacticsHallViewPageControl}"/>
			</suki:SukiSideMenuItem.PageContent>
		</suki:SukiSideMenuItem>

		<suki:SukiSideMenuItem Header="{Binding Language.HOMESCREEN_SIDE_MOD_MANANGMENT}"
							   Classes="Compact">
			<suki:SukiSideMenuItem.Icon>
				<materialIcons:MaterialIcon Kind="PackageVariantClosed" />
			</suki:SukiSideMenuItem.Icon>
			<suki:SukiSideMenuItem.PageContent>
				<ContentControl Content="{Binding ModsManagerPageViewControl}"/>
			</suki:SukiSideMenuItem.PageContent>
		</suki:SukiSideMenuItem>

		<suki:SukiSideMenu.HeaderContent>
			<Image Width="80"
				   Height="80"
				   Margin="30,10,30,30"
				   Classes="AppIcon"
				   Source="avares://TactiX_App/Assets/avalonia-logo.ico" />
		</suki:SukiSideMenu.HeaderContent>

		<suki:SukiSideMenu.FooterContent>
			<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
				<StackPanel.Styles>
					<Style Selector="materialIcons|MaterialIcon">
						<Setter Property="Width" Value="25" />
						<Setter Property="Height" Value="25" />
					</Style>
				</StackPanel.Styles>
				<Button Classes="Basic" Command="{Binding OpenWebUrlCommand}"
						CommandParameter="{Binding QqChatUrl}">
					<materialIcons:MaterialIcon Kind="Qqchat" />
				</Button>
				<Button Classes="Basic" Command="{Binding OpenWebUrlCommand}"
						CommandParameter="{Binding HomePageUrl}">
					<materialIcons:MaterialIcon Kind="Web" />
				</Button>
				<Button Classes="Basic" Command="{Binding ThemeSwtichCommand}">
					<materialIcons:MaterialIcon Kind="ThemeLightDark" />
				</Button>
				<Button Classes="Basic" Command="{Binding OpenPreparePageCommand}">
					<materialIcons:MaterialIcon Kind="BookPlay" />
				</Button>
			</StackPanel>
		</suki:SukiSideMenu.FooterContent>

	</suki:SukiSideMenu>

</UserControl>
