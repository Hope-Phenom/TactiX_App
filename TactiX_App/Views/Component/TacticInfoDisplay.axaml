<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="280"
             x:Class="TactiX_App.Views.Component.TacticInfoDisplay"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="StackPanel.Items">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Label.Items">
            <Setter Property="Width" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBox.Items">
            <Setter Property="Width" Value="250" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="10">
        <!-- 简单实现，不做模板了；后续继续优化 -->
        <ScrollViewer>
            <StackPanel Orientation="Vertical" Spacing="10">
                <!-- 战术名称 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayFileName}" />
                    <TextBox x:Name="TbxFileName"
                             Classes="Items" />
                </StackPanel>

                <!-- 战术作者 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayAuthor}" />
                    <TextBox x:Name="TbxAuthor"
                             Classes="Items" />
                </StackPanel>

                <!-- 战术介绍 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayDesc}" />
                    <TextBox x:Name="TbxDesc"
                             Classes="Items" />
                </StackPanel>

                <!-- 适用版本 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayFileName}" />
                    <TextBox x:Name="TbxApplyVer"
                             Classes="Items" />
                </StackPanel>

                <!-- 文件类型 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayType}" />
                    <TextBox x:Name="TbxType"
                             Classes="Items" />
                </StackPanel>

                <!-- 战术版本 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayTacVer}" />
                    <TextBox x:Name="TbxTacVer"
                             Classes="Items" />
                </StackPanel>

                <!-- 更新时间 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayUpdateTime}" />
                    <TextBox x:Name="TbxUpdateTime"
                             Classes="Items" />
                </StackPanel>

                <!-- Mod名称 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayModName}" />
                    <TextBox x:Name="TbxModName"
                             Classes="Items" />
                </StackPanel>

                <!-- 最低版本 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayModVer}" />
                    <TextBox x:Name="TbxModVer"
                             Classes="Items" />
                </StackPanel>

                <!-- 动作列表 -->
                <StackPanel Classes="Items">
                    <Label Classes="Items"
                           Content="{StaticResource TacticInfoDisplayActions}" />
                    <TextBox x:Name="TbxActions"
                             Classes="Items" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>