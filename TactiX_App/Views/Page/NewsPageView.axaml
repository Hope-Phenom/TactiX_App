<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
			 xmlns:vm="clr-namespace:TactiX_App.ViewModels.Page;assembly=TactiX_App"
			 xmlns:conv="clr-namespace:TactiX_App.Converter;assembly=TactiX_App"
			 mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="850"
			 x:DataType="vm:NewsPageViewModel"
			 x:Class="TactiX_App.Views.Page.NewsPageView"
			 x:Name="NewsPage">

	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="10" />
			<ColumnDefinition Width="450" />
		</Grid.ColumnDefinitions>
		<Grid Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="0.74*" />
				<RowDefinition Height="10" />
				<RowDefinition Height="0.26*" />
			</Grid.RowDefinitions>
			<suki:GlassCard Classes="HeaderCard" Grid.Row="0">
				<suki:GroupBox Header="{Binding Language.NEWS_PAGE_VIEW_TITLE_FORUM}">
					<ItemsRepeater ItemsSource="{Binding List_Topics, Mode=OneWay}">
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="0.8*" />
										<ColumnDefinition Width="10" />
										<ColumnDefinition Width="0.2*" />
									</Grid.ColumnDefinitions>
									<HyperlinkButton Command="{Binding DataContext.OpenWebCommand, ElementName=NewsPage}"
													 CommandParameter="{Binding Url}"
													 Grid.Column="0"
													 Padding="5 0 0 7">
										<HyperlinkButton.Content>
											<TextBlock Text="{Binding Title}" TextDecorations="{x:Null}" FontSize="16" />
										</HyperlinkButton.Content>
									</HyperlinkButton>
									<Label Content="{Binding Date}" Grid.Column="2"
										   HorizontalContentAlignment="Right"
										   FontSize="16"
										   Padding="0 0 5 7"/>
								</Grid>
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</suki:GroupBox>
			</suki:GlassCard>
			<suki:GlassCard Classes="HeaderCard" Grid.Row="2">
				<suki:GroupBox Header="{Binding Language.NEWS_PAGE_VIEW_TITLE_SYS_NEWS}">
					<ItemsRepeater ItemsSource="{Binding List_SysNews, Mode=OneWay}">
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="0.8*" />
										<ColumnDefinition Width="10" />
										<ColumnDefinition Width="0.2*" />
									</Grid.ColumnDefinitions>
									<HyperlinkButton Command="{Binding DataContext.OpenWebCommand, ElementName=NewsPage}"
													 CommandParameter="{Binding Link}"
													 Grid.Column="0"
													 Padding="5 0 0 7">
										<HyperlinkButton.Content>
											<TextBlock Text="{Binding Title}" TextDecorations="{x:Null}" FontSize="16" />
										</HyperlinkButton.Content>
									</HyperlinkButton>
									<Label Content="{Binding DateTimeStr}" Grid.Column="2"
										   HorizontalContentAlignment="Right"
										   FontSize="16"
										   Padding="0 0 5 7" />
								</Grid>
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</suki:GroupBox>
			</suki:GlassCard>
		</Grid>
		<Grid Grid.Column="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="0.74*" />
				<RowDefinition Height="10" />
				<RowDefinition Height="0.26*" />
			</Grid.RowDefinitions>
			<suki:GlassCard Classes="HeaderCard" Grid.Row="0">
				<suki:GroupBox Header="{Binding Language.NEWS_PAGE_VIEW_TITLE_VIDEOS}" >
					<ItemsRepeater ItemsSource="{Binding List_Videos, Mode=OneWay}">
						<ItemsRepeater.Layout>
							<UniformGridLayout MinItemWidth="192"
											   MinItemHeight="170"
											   MinRowSpacing="8"
											   MinColumnSpacing="25"
											   MaximumRowsOrColumns="5"
											   Orientation="Vertical" />
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<Grid Width="192" Height="170">
									<Grid.RowDefinitions>
										<RowDefinition Height="108" />
										<RowDefinition Height="3" />
										<RowDefinition Height="2*" />
										<RowDefinition Height="*" />
									</Grid.RowDefinitions>
									<Image Source="{Binding ImageObj}"
										   Grid.Row="0" />
									<HyperlinkButton Command="{Binding DataContext.OpenWebCommand, ElementName=NewsPage}"
													 CommandParameter="{Binding VideoUrl}"
													 Grid.Row="2">
										<HyperlinkButton.Content>
											<TextBlock Text="{Binding Title}" TextDecorations="{x:Null}" FontSize="12" MaxLines="2" TextWrapping="Wrap" />
										</HyperlinkButton.Content>
									</HyperlinkButton>
									<Label HorizontalAlignment="Left" HorizontalContentAlignment="Left"
										   Content="{Binding Author}" Grid.Row="3" FontSize="12" />
									<Label HorizontalAlignment="Right" HorizontalContentAlignment="Right"
										   Content="{Binding PublishDate}" Grid.Row="3" FontSize="12" />
								</Grid>
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</suki:GroupBox>
			</suki:GlassCard>
			<suki:GlassCard Classes="HeaderCard" Grid.Row="2">
				<suki:GroupBox Header="友情链接" Grid.Row="2">
					<Label Content="{Binding Language.NORMAL_TEXT_FRIENDSHIP_LINKS}"
						   VerticalContentAlignment="Center"
						   HorizontalContentAlignment="Center"/>
				</suki:GroupBox>
			</suki:GlassCard>
		</Grid>
	</Grid>

</UserControl>
