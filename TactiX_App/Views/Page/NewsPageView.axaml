<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:vm="clr-namespace:TactiX_App.ViewModels.Page;assembly=TactiX_App"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="850"
             x:DataType="vm:NewsPageViewModel"
             x:Class="TactiX_App.Views.Page.NewsPageView"
             x:Name="NewsPage">
    
    <Design.DataContext>
        <vm:NewsPageViewModel />
    </Design.DataContext>

    <Grid Margin="10" ColumnDefinitions="*,10,450">
        <Grid Grid.Column="0" RowDefinitions="0.74*,10,0.26*">
            <suki:GlassCard Classes="HeaderCard" Grid.Row="0">
                <suki:GroupBox Header="{StaticResource NewsPageViewTitleForum}">
                    <ItemsRepeater ItemsSource="{Binding ListTopics, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="0.8*,10,0.2*">
                                    <HyperlinkButton
                                        Command="{Binding DataContext.OpenWebCommand, ElementName=NewsPage}"
                                        CommandParameter="{Binding Url}"
                                        Grid.Column="0"
                                        Padding="5 0 0 7">
                                        <HyperlinkButton.Content>
                                            <TextBlock Text="{Binding Title}" TextDecorations="{x:Null}" FontSize="16" />
                                        </HyperlinkButton.Content>
                                    </HyperlinkButton>
                                    <Label Content="{Binding Date}" Grid.Column="2"
                                           HorizontalContentAlignment="Right"
                                           FontSize="16"
                                           Padding="0 0 5 7" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </suki:GroupBox>
            </suki:GlassCard>
            <suki:GlassCard Classes="HeaderCard" Grid.Row="2">
                <suki:GroupBox Header="{StaticResource NewsPageViewTitleSysNews}">
                    <ItemsRepeater ItemsSource="{Binding ListSysNews, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="0.8*,10,0.2*">
                                    <HyperlinkButton
                                        Command="{Binding DataContext.OpenWebCommand, ElementName=NewsPage}"
                                        CommandParameter="{Binding Link}"
                                        Grid.Column="0"
                                        Padding="5 0 0 7">
                                        <HyperlinkButton.Content>
                                            <TextBlock Text="{Binding Title}" TextDecorations="{x:Null}" FontSize="16" />
                                        </HyperlinkButton.Content>
                                    </HyperlinkButton>
                                    <Label Content="{Binding DateTimeStr}" Grid.Column="2"
                                           HorizontalContentAlignment="Right"
                                           FontSize="16"
                                           Padding="0 0 5 7" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </suki:GroupBox>
            </suki:GlassCard>
        </Grid>
        <Grid Grid.Column="2" RowDefinitions="0.74*,10,0.26*">
            <suki:GlassCard Classes="HeaderCard" Grid.Row="0">
                <suki:GroupBox Header="{StaticResource NewsPageViewTitleVideos}">
                    <ItemsRepeater ItemsSource="{Binding ListVideos, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="192"
                                               MinItemHeight="170"
                                               MinRowSpacing="8"
                                               MinColumnSpacing="25"
                                               MaximumRowsOrColumns="5"
                                               Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="192" Height="170" RowDefinitions="108,3,2*,*">
                                    <Image Source="{Binding ImageObj}"
                                           Grid.Row="0" />
                                    <HyperlinkButton
                                        Command="{Binding DataContext.OpenWebCommand, ElementName=NewsPage}"
                                        CommandParameter="{Binding VideoUrl}"
                                        Grid.Row="2">
                                        <HyperlinkButton.Content>
                                            <TextBlock Text="{Binding Title}" TextDecorations="{x:Null}" FontSize="12"
                                                       MaxLines="2" TextWrapping="Wrap" />
                                        </HyperlinkButton.Content>
                                    </HyperlinkButton>
                                    <Label HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                           Content="{Binding Author}" Grid.Row="3" FontSize="12" />
                                    <Label HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                                           Content="{Binding PublishDate}" Grid.Row="3" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </suki:GroupBox>
            </suki:GlassCard>
            <suki:GlassCard Classes="HeaderCard" Grid.Row="2">
                <suki:GroupBox Header="友情链接">
                    <Label Content="{StaticResource NormalTextFriendshipLinks}"
                           VerticalContentAlignment="Center"
                           HorizontalContentAlignment="Center" />
                </suki:GroupBox>
            </suki:GlassCard>
        </Grid>
    </Grid>

</UserControl>