<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:vm="clr-namespace:TactiX_App.ViewModels.Page;assembly=TactiX_App"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="850"
             x:DataType="vm:TacticsHallPageViewModel"
             x:Class="TactiX_App.Views.Page.TacticsHallPageView">

    <suki:GlassCard Margin="10">
        <Label Content="{StaticResource NormalTextDeveloping}"
               HorizontalAlignment="Center" HorizontalContentAlignment="Center"
               VerticalAlignment="Center" VerticalContentAlignment="Center"
               FontSize="18" />
    </suki:GlassCard>

</UserControl>