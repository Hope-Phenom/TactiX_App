<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:suki="https://github.com/kikipoulet/SukiUI"
			 xmlns:vm="clr-namespace:TactiX_App.ViewModels.Page;assembly=TactiX_App"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:ReplayAnalysisPageViewModel"
			 x:Class="TactiX_App.Views.Page.ReplayAnalysisPageView">

	<suki:GlassCard Margin="10">
		<Label Content="{Binding Language.NORMAL_TEXT_DEVELOPING}"
			   HorizontalAlignment="Center" HorizontalContentAlignment="Center"
			   VerticalAlignment="Center" VerticalContentAlignment="Center"
			   FontSize="24" />
	</suki:GlassCard>

</UserControl>
